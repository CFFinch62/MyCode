{
    "name": "mycode-fragbasic-language",
    "version": "1.0.0",
    "displayName": "FragBASIC Language Support",
    "description": "Syntax highlighting for FragBASIC (.bas) programs — a QBasic-compatible BASIC dialect",
    "author": "Chuck Finch",
    "license": "MIT",
    "mycode": {
        "activationEvents": [
            "onLanguage:fragbasic",
            "onStartup"
        ],
        "renderer": "renderer.js",
        "contributes": {
            "languages": [
                {
                    "id": "fragbasic",
                    "aliases": [
                        "FragBASIC",
                        "Fragbasic",
                        "QBasic"
                    ],
                    "extensions": [
                        ".bas"
                    ]
                }
            ]
        }
    }
}
