{
    "name": "mycode-runner",
    "version": "2.0.0",
    "displayName": "Language Runner",
    "description": "Compile and run programs in any language — configurable via Preferences → Runner",
    "author": "Chuck Finch",
    "license": "MIT",
    "mycode": {
        "activationEvents": [
            "onStartup"
        ],
        "renderer": "renderer.js",
        "main": "main.js",
        "contributes": {
            "commands": [
                {
                    "id": "runner.compile",
                    "title": "Compile",
                    "category": "Runner"
                },
                {
                    "id": "runner.run",
                    "title": "Run Program",
                    "category": "Runner"
                },
                {
                    "id": "runner.stop",
                    "title": "Stop Program",
                    "category": "Runner"
                }
            ]
        }
    }
}
